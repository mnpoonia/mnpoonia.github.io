---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CropProtectionNav from "../../../components/CropProtectionNav.astro";
import { cropOrganismOccurrences, crops, organisms, referenceUses, seasonality, sourceFor } from "../../../data/crop-protection";

export function getStaticPaths() {
  return crops.map((crop) => ({ params: { id: crop.id }, props: { crop } }));
}

const { crop } = Astro.props;
const occurrences = cropOrganismOccurrences.filter((occurrence) => occurrence.cropId === crop.id).map((occurrence) => ({
  ...occurrence,
  organism: organisms.find((organism) => organism.id === occurrence.organismId),
  seasonality: seasonality.filter((record) => record.cropId === crop.id && record.organismId === occurrence.organismId),
}));
const uses = referenceUses.filter((use) => use.cropId === crop.id);
const targetSections = occurrences.map((occurrence) => ({
  ...occurrence,
  uses: uses.filter((use) => use.organismId === occurrence.organismId),
}));
const unmatchedUses = uses.filter((use) => !occurrences.some((occurrence) => occurrence.organismId === use.organismId));
---
<BaseLayout title={`${crop.name} | Crop Protection Reference`} description={`Monitoring and organism reference for ${crop.name}.`}>
  <CropProtectionNav />
  <p class="eyebrow">Generated crop reference</p>
  <h1>{crop.name}</h1>
  {crop.scientificName && <p class="lede"><em>{crop.scientificName}</em></p>}
  {crop.id === "kinnow" && <section class="note">
    <strong>PPQS source mapping:</strong> the PPQS major-use table lists this crop category as <strong>Citrus</strong>, not Kinnow. Citrus-sourced entries below are shown for Kinnow as a transparent crop-category mapping and remain conditional until supported by the current product label.
  </section>}
  <p>Use the linked targets to identify what is affecting the crop, then review the formulation-specific registered-use information below. A dose belongs to a crop, target, and formulation; it is not a universal ingredient rate.</p>
  <section class="target-directory">
    <p class="eyebrow">Targets and formulation uses</p>
    <h2>Find the target before comparing a dose.</h2>
    <p class="muted">The use information below is organized by target. It is formulation-level evidence, not a product-label authorization or an automatic treatment decision.</p>
    {targetSections.map((occurrence) => occurrence.organism && <article class="target-card">
      <div class="target-heading">
        <div><p class="eyebrow">{occurrence.organism.type}</p><h3><a href={`/crop-protection/crops/${crop.id}/targets/${occurrence.organism.id}/`}>{occurrence.organism.name}</a></h3>{occurrence.organism.scientificName && <p><em>{occurrence.organism.scientificName}</em></p>}</div>
        <span class={occurrence.uses.length > 0 ? "badge conditional" : "badge unverified"}>{occurrence.uses.length > 0 ? `${occurrence.uses.length} use${occurrence.uses.length === 1 ? "" : "s"}` : "monitor"}</span>
      </div>
      <p>{occurrence.monitoringNote}</p>
      {occurrence.seasonality.map((record) => <p class="muted">Monitoring priority: {record.monitoringPriority} · Months: {record.months.join(", ")} · Evidence: {record.sourceIds.map((id) => <a href={sourceFor(id).url}>{sourceFor(id).publisher}</a>)}</p>)}
      <p class="target-action"><a href={`/crop-protection/crops/${crop.id}/targets/${occurrence.organism.id}/`}>Open target guide and decide the next step</a></p>
      {occurrence.uses.length > 0 ? <div class="use-list">
        {occurrence.uses.map((use) => <article class="use-card">
          <div><p class="eyebrow">Formulation</p><h4>{use.formulation}</h4>{use.sourceCrop && <p class="muted">PPQS crop category: {use.sourceCrop}</p>}</div>
          <dl><div><dt>Dose</dt><dd>{use.dose}</dd></div><div><dt>Water / dilution</dt><dd>{use.waterVolume}</dd></div></dl>
          <p class="use-note">{use.timing}</p>
          <p class="use-action"><a href="/crop-protection/products/">Check an exact product label before use</a> · <a href="/crop-protection/sources/">Read source boundary</a></p>
        </article>)}
      </div> : <p class="no-use">No formulation use is currently reviewed for this target. Continue identification and monitoring; absence here is not evidence that no option exists.</p>}
    </article>)}
    {unmatchedUses.map((use) => <article class="use-card"><h3>{use.target}</h3><p>{use.formulation} · {use.dose} · {use.waterVolume}</p></article>)}
  </section>
</BaseLayout>
