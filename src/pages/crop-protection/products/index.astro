---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CropProtectionNav from "../../../components/CropProtectionNav.astro";
import ProductLookup from "../../../components/ProductLookup.astro";
import { products } from "../../../data/crop-protection";
---
<BaseLayout title="Product Reference | Crop Protection Reference" description="Search a catalog product and see its ingredients and crop-specific documented dose records.">
  <CropProtectionNav />
  <p class="eyebrow">Product reference</p>
  <h1>Check the package after choosing a crop and target.</h1>
  <p class="lede">Search a brand only when you know the formulation on the package. Product pages distinguish an exact product record from a formulation-level reference; neither replaces the current container label.</p>
  <ProductLookup />
  <section>
    <h2>Current Prototype Catalog</h2>
    <div class="grid">
      {products.map((product) => <article class="card"><span class={`badge ${product.status}`}>{product.status}</span><h3><a href={`/crop-protection/products/${product.id}/`}>{product.brand}</a></h3><p>{product.manufacturer}<br /><strong>{product.formulation}</strong></p></article>)}
    </div>
  </section>
  <section class="note"><strong>Evidence ladder:</strong> exact current product label is strongest. A PPQS formulation entry can support a formulation-use reference, but does not prove that every brand with a similar ingredient is authorized. An absent product means only that it is not in this prototype catalog.</section>
</BaseLayout>
