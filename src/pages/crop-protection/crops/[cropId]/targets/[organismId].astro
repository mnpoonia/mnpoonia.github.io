---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CropProtectionNav from "../../../../../components/CropProtectionNav.astro";
import ImageGallery from "../../../../../components/ImageGallery.astro";
import ObservationGuide from "../../../../../components/ObservationGuide.astro";
import { crops, cropOrganismOccurrences, imageAssets, organisms, organismStages, referenceUses, sourceFor } from "../../../../../data/crop-protection";

export function getStaticPaths() {
  return cropOrganismOccurrences.filter((occurrence) => ["kinnow", "cotton"].includes(occurrence.cropId)).map((occurrence) => ({ params: { cropId: occurrence.cropId, organismId: occurrence.organismId } }));
}
const crop = crops.find((item) => item.id === Astro.params.cropId)!;
const organism = organisms.find((item) => item.id === Astro.params.organismId)!;
const occurrence = cropOrganismOccurrences.find((item) => item.cropId === crop.id && item.organismId === organism.id)!;
const stages = organismStages.filter((stage) => stage.organismId === organism.id).sort((left, right) => left.order - right.order);
const uses = referenceUses.filter((use) => use.cropId === crop.id && use.organismId === organism.id);
---
<BaseLayout title={`${crop.name}: ${organism.name} | Crop Protection Reference`} description={`Identification and formulation-use reference for ${organism.name} in ${crop.name}.`}>
  <CropProtectionNav />
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/crop-protection/crops/">Crops</a><span>/</span><a href={`/crop-protection/crops/${crop.id}/`}>{crop.name}</a><span>/</span><span>{organism.name}</span></nav>
  <header class="page-intro target-intro"><p class="eyebrow">Crop-target reference</p><h1>{organism.name}</h1><p class="lede">{crop.name} · {organism.type}{organism.scientificName && <> · <em>{organism.scientificName}</em></>}</p><p>{occurrence.monitoringNote}</p></header>
  <ObservationGuide cropName={crop.name} targetName={organism.name} targetHref={`/crop-protection/organisms/${organism.id}/`} hasUses={uses.length > 0} />
  <section><h2>Confirm the target</h2>{stages.length ? <div class="grid">{stages.map((stage) => <article class="card"><h3>{stage.name}</h3><ImageGallery heading="Reference image" images={imageAssets.filter((image) => image.stageId === stage.id)} /><p><strong>Where to look:</strong> {stage.whereToLook}</p><p><strong>What you can see:</strong> {stage.visibility}</p><p><strong>Immediate action:</strong> {stage.immediateAction}</p></article>)}</div> : <p class="note">This target has no detailed stage guide yet. Use the monitoring note above and confirm with local expertise before acting.</p>}</section>
  <section><h2>Formulation uses for this crop and target</h2>{uses.length ? <div class="use-list">{uses.map((use) => <article class="use-card"><div><p class="eyebrow">Formulation</p><h3>{use.formulation}</h3>{use.sourceCrop && <p class="muted">PPQS crop category: {use.sourceCrop}</p>}</div><dl><div><dt>Dose</dt><dd>{use.dose}</dd></div><div><dt>Water / dilution</dt><dd>{use.waterVolume}</dd></div></dl><p class="use-note">{use.timing}</p><p class="use-action">{use.sourceIds.map((id) => <a href={sourceFor(id).url}>{sourceFor(id).publisher}</a>)} · <a href="/crop-protection/products/">Check exact product and current label</a></p></article>)}</div> : <p class="note">No formulation use is reviewed for this crop-target pair. Keep monitoring and seek current local guidance; do not transfer a rate from another crop or formulation.</p>}</section>
  <section class="next-step"><h2>Before you leave</h2><p>Return to the crop for other targets, or use the product catalog only after you know the exact formulation on the package.</p><a class="button secondary" href={`/crop-protection/crops/${crop.id}/`}>Back to {crop.name}</a></section>
</BaseLayout>
