---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CropProtectionNav from "../../../../../components/CropProtectionNav.astro";
import ImageGallery from "../../../../../components/ImageGallery.astro";
import ObservationGuide from "../../../../../components/ObservationGuide.astro";
import EvidenceStatus from "../../../../../components/EvidenceStatus.astro";
import SourceLinks from "../../../../../components/SourceLinks.astro";
import UseCard from "../../../../../components/UseCard.astro";
import { crops, cropOrganismOccurrences, imageAssets, labelUses, lookAlikes, managementActions, organisms, organismStages, products, referenceUses, scoutingProtocols, thresholds } from "../../../../../data/crop-protection";

export function getStaticPaths() {
  return cropOrganismOccurrences.map((occurrence) => ({ params: { cropId: occurrence.cropId, organismId: occurrence.organismId } }));
}
const crop = crops.find((item) => item.id === Astro.params.cropId)!;
const organism = organisms.find((item) => item.id === Astro.params.organismId)!;
const occurrence = cropOrganismOccurrences.find((item) => item.cropId === crop.id && item.organismId === organism.id)!;
const stages = organismStages.filter((stage) => stage.organismId === organism.id).sort((left, right) => left.order - right.order);
const uses = referenceUses.filter((use) => use.cropId === crop.id && use.organismId === organism.id);
const protocol = scoutingProtocols.find((record) => record.cropId === crop.id && record.organismId === organism.id);
const threshold = thresholds.find((record) => record.cropId === crop.id && record.organismId === organism.id);
const actions = managementActions.filter((record) => record.cropId === crop.id && record.organismId === organism.id);
const comparisons = lookAlikes.filter((record) => record.cropId === crop.id && record.organismId === organism.id);
const exactLabelUses = labelUses.filter((record) => record.cropId === crop.id && record.organismId === organism.id);
const hasRateConflict = (use: typeof uses[number]) => uses.some((candidate) => candidate !== use && candidate.formulation === use.formulation && (candidate.dose !== use.dose || candidate.waterVolume !== use.waterVolume));
---
<BaseLayout title={`${crop.name}: ${organism.name} | Crop Protection Reference`} description={`Identification and formulation-use reference for ${organism.name} in ${crop.name}.`}>
  <CropProtectionNav />
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/crop-protection/crops/">Crops</a><span>/</span><a href={`/crop-protection/crops/${crop.id}/`}>{crop.name}</a><span>/</span><span>{organism.name}</span></nav>
  <header class="page-intro target-intro"><p class="eyebrow">Crop-target reference</p><h1>{organism.name}</h1><p class="lede">{crop.name} · {organism.type}{organism.scientificName && <> · <em>{organism.scientificName}</em></>}</p><p>{occurrence.monitoringNote}</p></header>
  <ObservationGuide cropName={crop.name} targetName={organism.name} targetHref={`/crop-protection/organisms/${organism.id}/`} hasUses={uses.length > 0} />
  <section><p class="eyebrow">1. Recognize</p><h2>Confirm the target before comparing a treatment.</h2>{stages.length ? <div class="grid">{stages.map((stage) => <article class="card"><h3>{stage.name}</h3><ImageGallery heading="Reference image" images={imageAssets.filter((image) => image.stageId === stage.id)} /><p><strong>Where to look:</strong> {stage.whereToLook}</p><p><strong>What you can see:</strong> {stage.visibility}</p><p><strong>Immediate action:</strong> {stage.immediateAction}</p><p class="muted">{stage.managementEvidence}</p></article>)}</div> : <p class="note">This target has no detailed guide yet. Use the monitoring note above and confirm with local expertise before acting.</p>}</section>
  <section><p class="eyebrow">2. Compare look-alikes</p><h2>Rule out similar causes.</h2>{comparisons.length ? <div class="grid">{comparisons.map((comparison) => <article class="card"><h3>{comparison.name}</h3><p>{comparison.distinction}</p><p><strong>Next:</strong> {comparison.action}</p><EvidenceStatus status={comparison.evidenceStatus} /><SourceLinks sourceIds={comparison.sourceIds} /></article>)}</div> : <p class="no-use">No look-alike comparison is reviewed yet. Treat identification confidence as limited.</p>}</section>
  <section><p class="eyebrow">3. Inspect and record</p><h2>Use a repeatable field observation.</h2>{protocol ? <article class="scouting-card"><h3>{protocol.name}</h3><p><strong>Frequency:</strong> {protocol.frequency}</p><p><strong>Sample unit:</strong> {protocol.sampleUnit}</p><p><strong>Sample size:</strong> {protocol.sampleSize}</p><p><strong>Method:</strong></p><ul>{protocol.method.map((step) => <li>{step}</li>)}</ul><p><strong>Record:</strong> {protocol.record.join(" · ")}</p><EvidenceStatus status={protocol.evidenceStatus} /><SourceLinks sourceIds={protocol.sourceIds} /></article> : <p class="no-use">No reviewed scouting protocol is recorded. Use the monitoring note and seek local guidance rather than inventing a sample size.</p>}</section>
  <section><p class="eyebrow">4. Is action justified?</p><h2>Threshold status</h2>{threshold ? <article class="scouting-card"><p><strong>{threshold.metric}</strong></p><p>{threshold.operator === "presence-based" ? threshold.unit : `${threshold.operator} ${threshold.value} ${threshold.unit}`}</p><p><strong>Documented next step:</strong> {threshold.action.replaceAll("-", " ")}</p><EvidenceStatus status={threshold.evidenceStatus} /><SourceLinks sourceIds={threshold.sourceIds} /></article> : <p class="no-use">No threshold is reviewed for this crop-target pair. That does not establish a treatment decision.</p>}</section>
  <section><p class="eyebrow">5. Act without a pesticide first</p><h2>Documented management actions</h2>{actions.length ? <div class="grid">{actions.map((action) => <article class="card"><p class="eyebrow">{action.category}</p><h3>{action.title}</h3><p>{action.action}</p>{action.limitations && <p class="muted"><strong>Limit:</strong> {action.limitations}</p>}<EvidenceStatus status={action.evidenceStatus} /><SourceLinks sourceIds={action.sourceIds} /></article>)}</div> : <p class="no-use">No nonchemical action is reviewed yet. This is an evidence gap, not a reason to skip identification.</p>}</section>
  <section><p class="eyebrow">6. Treatment evidence</p><h2>Exact label uses and formulation references</h2>{exactLabelUses.length > 0 && <div class="exact-label-list"><h3>Exact product-label records</h3>{exactLabelUses.map((record) => { const product = products.find((item) => item.id === record.productId); return <article class="label-use-card"><p><strong>Product:</strong> {product ? `${product.brand} (${product.formulation})` : record.productId}</p><p><strong>Claim:</strong> {record.claim}</p><p><strong>Dose:</strong> {record.dose}</p>{record.waterVolume && <p><strong>Water:</strong> {record.waterVolume}</p>}{record.phi && <p><strong>Pre-harvest interval:</strong> {record.phi}</p>}<p><strong>Label state:</strong> {record.labelVersion}</p>{record.restrictions.map((restriction) => <p class="use-condition">{restriction}</p>)}<EvidenceStatus status={record.verificationStatus} /><p><a href={record.labelUrl}>Open product source</a></p></article>; })}</div>}{uses.length ? <div class="use-list"><h3>Formulation references</h3>{uses.map((use) => <UseCard use={use} conflict={hasRateConflict(use)} />)}</div> : <p class="note">No formulation use is reviewed for this crop-target pair. Keep monitoring and seek current local guidance; do not transfer a rate from another crop or formulation.</p>}</section>
  <section class="next-step"><h2>Before you leave</h2><p>Return to the crop for other targets, or use the product catalog only after you know the exact formulation on the package.</p><a class="button secondary" href={`/crop-protection/crops/${crop.id}/`}>Back to {crop.name}</a></section>
</BaseLayout>
